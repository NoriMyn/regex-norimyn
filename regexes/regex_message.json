{
    "id": "c0f289c6-ea7d-44be-bed8-0b8ba946ddc4",
    "scriptName": "Оформление SMS",
    "findRegex": "/(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$)(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?(?:(\\(out\\)|\\(in\\))\\s+(.*?)\\s*\\|\\s*(.*?)(?:\\n|$))?/g",
    "replaceString": "<div class=\"imsg-wrap\"><style>@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap');.imsg-wrap{font-family:'DM Sans',system-ui,sans-serif!important;display:flex;justify-content:center;margin:12px 0}.imsg-details{width:clamp(320px,60vw,560px);background:linear-gradient(180deg,#16151f,#0d0c14);border:1px solid rgba(255,255,255,0.08);border-radius:18px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.7)}.imsg-summary{list-style:none;display:flex;align-items:center;justify-content:center;gap:6px;padding:10px 16px;cursor:pointer;user-select:none}.imsg-summary::-webkit-details-marker{display:none}.imsg-dot{width:5px;height:5px;border-radius:50%;background:#9b7bff;box-shadow:0 0 6px #9b7bff;animation:neon-pulse 1.8s ease-in-out infinite}.imsg-label{font-size:12px!important;letter-spacing:0.03em;color:rgba(255,255,255,0.5)}.imsg-body{padding:16px;display:flex;flex-direction:column;gap:10px;border-top:1px solid rgba(255,255,255,0.06)}.imsg-msg{display:none;flex-direction:column;gap:3px}.imsg-details[open] .imsg-msg[data-dir=\"(in)\"],.imsg-details[open] .imsg-msg[data-dir=\"(out)\"]{display:flex;animation:msg-in 1.2s cubic-bezier(.22,.68,0,1.2) both}.imsg-msg[data-dir=\"(in)\"]{align-items:flex-start;width:100%}.imsg-msg[data-dir=\"(out)\"]{align-items:flex-end;width:100%}.imsg-name{font-size:10px!important;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.4);padding:0 10px}.imsg-bubble{padding:8px 12px;border-radius:10px;font-size:13.5px!important;line-height:1.5!important;color:#eee;max-width:85%}.imsg-msg[data-dir=\"(in)\"] .imsg-bubble{background:rgba(255,255,255,0.05);border-left:2px solid #9b7bff}.imsg-msg[data-dir=\"(out)\"] .imsg-bubble{background:linear-gradient(140deg,#7b5cff,#3a2fff);color:#fff;box-shadow:0 4px 16px rgba(123,92,255,0.3)}.imsg-footer{display:flex;align-items:center;gap:6px;padding:10px 12px}.imsg-input{flex:1;border:1px solid rgba(255,255,255,0.07);border-radius:14px;padding:6px 10px;color:rgba(255,255,255,0.3);font-size:12px!important;background:rgba(255,255,255,0.04)}.imsg-send{width:26px;height:26px;background:linear-gradient(135deg,#7b5cff,#3a2fff);border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(123,92,255,0.3)}.imsg-send svg{width:11px;height:11px;fill:none;stroke:#fff;stroke-width:2}@keyframes neon-pulse{0%,100%{box-shadow:0 0 4px #9b7bff}50%{box-shadow:0 0 10px #9b7bff}}@keyframes msg-in{from{opacity:0;transform:translateY(8px) scale(0.97)}to{opacity:1;transform:translateY(0) scale(1)}}.imsg-details[open] .imsg-msg:nth-child(1){animation-delay:.2s}.imsg-details[open] .imsg-msg:nth-child(2){animation-delay:1.4s}.imsg-details[open] .imsg-msg:nth-child(3){animation-delay:2.6s}.imsg-details[open] .imsg-msg:nth-child(4){animation-delay:3.8s}.imsg-details[open] .imsg-msg:nth-child(5){animation-delay:5s}.imsg-details[open] .imsg-msg:nth-child(6){animation-delay:6.2s}.imsg-details[open] .imsg-msg:nth-child(7){animation-delay:7.4s}.imsg-details[open] .imsg-msg:nth-child(8){animation-delay:8.6s}</style><details class=\"imsg-details\"><summary class=\"imsg-summary\"><span class=\"imsg-dot\"></span><span class=\"imsg-label\">New Notification</span></summary><div class=\"imsg-body\"><div class=\"imsg-msg\" data-dir=\"$1\"><span class=\"imsg-name\">$2</span><div class=\"imsg-bubble\">$3</div></div><div class=\"imsg-msg\" data-dir=\"$4\"><span class=\"imsg-name\">$5</span><div class=\"imsg-bubble\">$6</div></div><div class=\"imsg-msg\" data-dir=\"$7\"><span class=\"imsg-name\">$8</span><div class=\"imsg-bubble\">$9</div></div><div class=\"imsg-msg\" data-dir=\"$10\"><span class=\"imsg-name\">$11</span><div class=\"imsg-bubble\">$12</div></div><div class=\"imsg-msg\" data-dir=\"$13\"><span class=\"imsg-name\">$14</span><div class=\"imsg-bubble\">$15</div></div><div class=\"imsg-msg\" data-dir=\"$16\"><span class=\"imsg-name\">$17</span><div class=\"imsg-bubble\">$18</div></div><div class=\"imsg-msg\" data-dir=\"$19\"><span class=\"imsg-name\">$20</span><div class=\"imsg-bubble\">$21</div></div><div class=\"imsg-msg\" data-dir=\"$22\"><span class=\"imsg-name\">$23</span><div class=\"imsg-bubble\">$24</div></div></div><div class=\"imsg-footer\"><div class=\"imsg-input\">Enter a new message</div><div class=\"imsg-send\"><svg viewBox=\"0 0 24 24\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg></div></div></details></div>",
    "trimStrings": [],
    "placement": [
        1,
        2
    ],
    "disabled": false,
    "markdownOnly": true,
